{%- doc -%}
  The partner family for snippets/bundled-image.liquid. Generated by
  scripts/build_bundled_images.py -- edit the script, not this file.

  @param {string} key - the full bundled-image key
  @param {string} [class] - CSS classes for the <img>
  @param {string} [alt] - overrides the generated alt text
  @param {string} [style] - inline style for the <img>
  @param {string} [loading] - loading attribute (default lazy)
{%- enddoc -%}

{%- liquid
  assign file = ''
  assign label = ''
  assign width = 0
  assign height = 0
  case key
    when 'partner-the-nation-network'
      assign file = 'tnn-wordmark.png'
      assign label = "The Nation Network"
      assign width = 900
      assign height = 260
    when 'partner-betway'
      assign file = 'partner-betway.png'
      assign label = "Betway"
      assign width = 520
      assign height = 312
    when 'partner-boston-pizza'
      assign file = 'partner-boston-pizza.png'
      assign label = "Boston Pizza"
      assign width = 520
      assign height = 312
    when 'partner-skip-the-dishes'
      assign file = 'partner-skip-the-dishes.png'
      assign label = "Skip The Dishes"
      assign width = 520
      assign height = 312
    when 'partner-bet365'
      assign file = 'partner-bet365.png'
      assign label = "Bet365"
      assign width = 520
      assign height = 312
    when 'partner-montanas'
      assign file = 'partner-montanas.png'
      assign label = "Montanas"
      assign width = 520
      assign height = 312
    when 'partner-adidas'
      assign file = 'partner-adidas.png'
      assign label = "Adidas"
      assign width = 520
      assign height = 312
    when 'partner-ufc'
      assign file = 'partner-ufc.png'
      assign label = "UFC"
      assign width = 520
      assign height = 312
    when 'partner-jasper-canada'
      assign file = 'partner-jasper-canada.png'
      assign label = "Jasper Canada"
      assign width = 520
      assign height = 312
    when 'partner-doordash'
      assign file = 'partner-doordash.png'
      assign label = "Doordash"
      assign width = 520
      assign height = 312
    when 'partner-wendys'
      assign file = 'partner-wendys.png'
      assign label = "Wendy's"
      assign width = 520
      assign height = 312
    when 'partner-seagrams'
      assign file = 'partner-seagrams.png'
      assign label = "Seagrams"
      assign width = 520
      assign height = 312
    when 'partner-booster-juice'
      assign file = 'partner-booster-juice.png'
      assign label = "Booster Juice"
      assign width = 520
      assign height = 312
    when 'partner-telus'
      assign file = 'partner-telus.png'
      assign label = "Telus"
      assign width = 520
      assign height = 312
    when 'partner-servus-credit-union'
      assign file = 'partner-servus-credit-union.png'
      assign label = "Servus Credit Union"
      assign width = 520
      assign height = 312
    when 'partner-finning'
      assign file = 'partner-finning.png'
      assign label = "Finning"
      assign width = 520
      assign height = 312
    when 'partner-jp-wisers'
      assign file = 'partner-jp-wisers.png'
      assign label = "JP Wisers"
      assign width = 520
      assign height = 312
    when 'partner-yeti'
      assign file = 'partner-yeti.png'
      assign label = "Yeti"
      assign width = 520
      assign height = 312
    when 'partner-odd-brewing-company'
      assign file = 'partner-odd-brewing-company.png'
      assign label = "Odd Brewing Company"
      assign width = 520
      assign height = 312
    when 'partner-greta'
      assign file = 'partner-greta.png'
      assign label = "Greta"
      assign width = 520
      assign height = 312
    when 'partner-fanduel'
      assign file = 'partner-fanduel.png'
      assign label = "FanDuel"
      assign width = 520
      assign height = 312
  endcase
  assign loading = loading | default: 'lazy'
  if alt != blank
    assign label = alt
  endif
-%}

{%- if file != blank -%}
  <img
    src="{{ file | asset_url }}"
    alt="{{ label | escape }}"
    class="{{ class }}"
    width="{{ width }}"
    height="{{ height }}"
    {% if style != blank %}style="{{ style }}"{% endif %}
    loading="{{ loading }}"
    decoding="async"
  >
{%- endif -%}

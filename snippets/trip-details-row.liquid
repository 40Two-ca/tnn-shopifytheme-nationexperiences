{%- doc -%}
  One accordion row for the trip-details block.

  @param {string} heading - Row heading
  @param {string} content - HTML content for the row
  @param {boolean} [open] - Open by default
  @param {string} [attributes] - Extra HTML attributes for the row, e.g. block.shopify_attributes

  Rows must stay direct siblings inside their `.accordion--dividers` wrapper: the
  divider between rows is drawn with `accordion-custom:not(:first-child)`, so any
  wrapper element around a row silently removes every divider in the group. Pass
  `attributes` instead of wrapping the row.
{%- enddoc -%}

{%- capture row -%}
  <details
    class="details"
    {% if open %}
      open
    {% endif %}
    {{ attributes }}
  >
    <summary class="details__header">
      {{ heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="details-content">
      <div class="rte trip-details__content">
        {{ content }}
      </div>
    </div>
  </details>
{%- endcapture -%}

{% render 'accordion-custom-component',
  children: row,
  open_by_default_on_desktop: open,
  open_by_default_on_mobile: open
%}

{%- doc -%}
  Resolves a bundled brand image (assets/brand-*, assets/partner-*, assets/team-*,
  assets/photo-*, assets/tnn-*) from a key, so the network's logos, photography
  and portraits render before anyone has uploaded them to Shopify Files. A real
  image picked in the editor always wins: sections only fall back to this.

  One case per family, in bundled-image-<family>.liquid. It was a single case
  over every key until that tripped theme check's LiquidComplexity rule at 133
  against a maximum of 120.

  Generated by scripts/build_bundled_images.py -- edit the script, not this file.

  @param {string} key - '<family>-<handleized name>', e.g. 'brand-daily-faceoff'
  @param {string} [class] - CSS classes for the <img>
  @param {string} [alt] - overrides the generated alt text
  @param {string} [style] - inline style for the <img>
  @param {string} [loading] - loading attribute (default lazy)
{%- enddoc -%}

{%- liquid
  assign family = key | split: '-' | first
  case family
    when 'identity'
      render 'bundled-image-identity', key: key, class: class, alt: alt, style: style, loading: loading
    when 'brand'
      render 'bundled-image-brand', key: key, class: class, alt: alt, style: style, loading: loading
    when 'partner'
      render 'bundled-image-partner', key: key, class: class, alt: alt, style: style, loading: loading
    when 'team'
      render 'bundled-image-team', key: key, class: class, alt: alt, style: style, loading: loading
    when 'photo'
      render 'bundled-image-photo', key: key, class: class, alt: alt, style: style, loading: loading
  endcase
-%}

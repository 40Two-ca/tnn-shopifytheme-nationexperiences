    src="{{ file | asset_url }}"
    alt="{{ label | escape }}"
    class="{{ class }}"
    width="{{ width }}"
    height="{{ height }}"
    {% if style != blank %}style="{{ style }}"{% endif %}
    loading="{{ loading }}"
    decoding="async"

{%- doc -%}
  The team family for snippets/bundled-image.liquid. Generated by
  scripts/build_bundled_images.py -- edit the script, not this file.

  @param {string} key - the full bundled-image key
  @param {string} [class] - CSS classes for the <img>
  @param {string} [alt] - overrides the generated alt text
  @param {string} [style] - inline style for the <img>
  @param {string} [loading] - loading attribute (default lazy)
{%- enddoc -%}

{%- liquid
  assign file = ''
  assign label = ''
  assign width = 0
  assign height = 0
  case key
    when 'team-jay-downton'
      assign file = 'team-jay-downton.jpg'
      assign label = "Jay Downton"
      assign width = 560
      assign height = 560
    when 'team-mike-gagnon'
      assign file = 'team-mike-gagnon.jpg'
      assign label = "Mike Gagnon"
      assign width = 560
      assign height = 560
    when 'team-jarrod-sharp'
      assign file = 'team-jarrod-sharp.jpg'
      assign label = "Jarrod Sharp"
      assign width = 560
      assign height = 560
    when 'team-mike-alexander'
      assign file = 'team-mike-alexander.jpg'
      assign label = "Mike Alexander"
      assign width = 560
      assign height = 560
    when 'team-madisen-rayburn'
      assign file = 'team-madisen-rayburn.jpg'
      assign label = "Madisen Rayburn"
      assign width = 560
      assign height = 560
    when 'team-amil-delic'
      assign file = 'team-amil-delic.jpg'
      assign label = "Amil Delic"
      assign width = 560
      assign height = 560
    when 'team-tyler-yaremchuk'
      assign file = 'team-tyler-yaremchuk.jpg'
      assign label = "Tyler Yaremchuk"
      assign width = 560
      assign height = 560
    when 'team-jason-gregor'
      assign file = 'team-jason-gregor.jpg'
      assign label = "Jason Gregor"
      assign width = 560
      assign height = 560
    when 'team-brock-seguin'
      assign file = 'team-brock-seguin.jpg'
      assign label = "Brock Seguin"
      assign width = 560
      assign height = 560
  endcase
  assign loading = loading | default: 'lazy'
  if alt != blank
    assign label = alt
  endif
-%}

{%- if file != blank -%}
  <img
    src="{{ file | asset_url }}"
    alt="{{ label | escape }}"
    class="{{ class }}"
    width="{{ width }}"
    height="{{ height }}"
    {% if style != blank %}style="{{ style }}"{% endif %}
    loading="{{ loading }}"
    decoding="async"
  >
{%- endif -%}

{%- doc -%}
  "What's included" and "What's not included" lists (Contiki's inclusions block).

  The lists themselves live in the trip-inclusions-lists snippet so the
  trip-overview section can show the same thing. Styles live in assets/brand.css
  for the same reason.
{%- enddoc -%}

{%- liquid
  capture lists
    render 'trip-inclusions-lists',
      product: closest.product,
      included_heading: block.settings.included_heading,
      excluded_heading: block.settings.excluded_heading
  endcapture

  assign has_lists = lists | strip
-%}

{%- if has_lists != blank -%}
  <div class="trip-inclusions" {{ block.shopify_attributes }}>
    {{ lists }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "What's included",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the product metafields custom.included and custom.not_included: one item per line. Start a line with an icon name and a pipe to change the icon, for example \"plane | Return airfare from Edmonton\"."
    },
    {
      "type": "text",
      "id": "included_heading",
      "label": "Included heading",
      "default": "What's included"
    },
    {
      "type": "text",
      "id": "excluded_heading",
      "label": "Not included heading",
      "default": "What's not included"
    }
  ],
  "presets": [
    {
      "name": "What's included"
    }
  ]
}
{% endschema %}

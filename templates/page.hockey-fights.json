      "settings": {
        "eyebrow": "hockeyfights.com",
        "heading": "Every drop of the gloves, catalogued",
        "body": "<p>Hockey Fights offers a comprehensive collection of videos, statistics and analysis from various leagues and eras. From jaw-dropping knockouts to epic battles between rival teams, the site captures and catalogues the most memorable moments in hockey fighting history, alongside player profiles, historical data and a passionate community of like-minded fans.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48,
        "button_label": "Visit hockeyfights.com",
        "button_link": "https://hockeyfights.com/",
        "button_style": "button"
      }
    },

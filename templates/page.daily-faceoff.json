          }
        },
        "social": {
          "type": "stat",
          "settings": {
            "value": "176",
            "suffix": "K+",
            "decimals": 0,
            "label": "Social media followers"
          }
        }
      },
      "block_order": [
        "pageviews",
        "streams",
        "social"
      ]
    }
  },
  "order": [
    "header",
    "site",

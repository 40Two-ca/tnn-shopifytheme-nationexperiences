{
  "sections": {
    "header": {
      "type": "section",
      "blocks": {
        "title": {
          "type": "text",
          "name": "Title",
          "settings": {
            "text": "<h1>Daily Faceoff</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "uppercase",
            "wrap": "balance"
          },
          "blocks": {}
        },
        "intro": {
          "type": "text",
          "name": "Intro",
          "settings": {
            "text": "<p>The ultimate destination for NHL enthusiasts, delivering up-to-the-minute breaking news, expert insights and thought-provoking opinions.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "title",
        "intro"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 16,
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 16
      }
    },
    "site": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-site-dailyfaceoff",
            "alt": "dailyfaceoff.com open on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-site-dailyfaceoff-mobile",
            "alt": "dailyfaceoff.com open on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "dailyfaceoff.com",
        "heading": "Breaking news, lineups and fantasy",
        "body": "<p>A website dedicated to giving NHL fans breaking news, lineup information, player updates, fantasy hockey resources and in-depth analysis. Whether you are a dedicated NHL fan or a passionate fantasy hockey player, dailyfaceoff.com is the go-to destination.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48,
        "button_label": "Visit dailyfaceoff.com",
        "button_link": "https://dailyfaceoff.com/",
        "button_style": "button"
      }
    },
    "live": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-dfo-live",
            "alt": "Daily Faceoff Live on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-dfo-live-mobile",
            "alt": "Daily Faceoff Live on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "With Tyler Yaremchuk",
        "heading": "Daily Faceoff Live",
        "body": "<p>This show digs into the latest news, analysis and storylines from the world of professional hockey. Each episode features expert guests, player interviews and in-depth conversations covering everything from game previews and recaps to player performances and trade rumours.</p>",
        "media_position": "left",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48,
        "background_color": "{{ settings.color_palette.color3 }}"
      }
    },
    "rundown": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-dfo-rundown",
            "alt": "The DFO Rundown on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-dfo-rundown-mobile",
            "alt": "The DFO Rundown on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "With Jason Gregor",
        "heading": "DFO Rundown",
        "body": "<p>A weekly dose of insightful analysis, spirited discussion and humorous banter. From game highlights and standout performances to trade rumours and playoff predictions, the DFO Rundown covers it all with a blend of expertise and entertainment.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "frankly": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-frankly-speaking",
            "alt": "Frankly Speaking on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-frankly-speaking-mobile",
            "alt": "Frankly Speaking on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "With Frank Seravalli",
        "heading": "Frankly Speaking",
        "body": "<p>Frank Seravalli built his media career on always wanting to know more than what is on the surface. Every week Frank is joined by someone from around the hockey world who shares their story: no set questions, no time frame, just an honest conversation about life, the sport and whatever else comes up.</p>",
        "media_position": "left",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48,
        "background_color": "{{ settings.color_palette.color3 }}"
      }
    },
    "fantasy": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-dfo-fantasy",
            "alt": "The DFO Fantasy Podcast on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-dfo-fantasy-mobile",
            "alt": "The DFO Fantasy Podcast on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "With Brock Seguin",
        "heading": "DFO Fantasy Podcast",
        "body": "<p>Brock Seguin and a team of experienced fantasy hockey enthusiasts bring insights, analysis and strategies to help you dominate your league. Whether you are a seasoned fantasy player looking for an edge or a beginner learning the ropes, the DFO Fantasy podcast has you covered.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "cuppa": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-morning-cuppa-hockey",
            "alt": "Morning Cuppa Hockey on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-morning-cuppa-hockey-mobile",
            "alt": "Morning Cuppa Hockey on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "With Jonny Lazarus and Colby Cohen",
        "heading": "Morning Cuppa Hockey",
        "body": "<p>Jonny Lazarus and Colby Cohen know their hockey, but they do not always agree on it. Having played at multiple levels -- and won a Stanley Cup between them -- they spend each morning on the latest news, trends and controversial plays, and introduce you to some interesting characters from around the game.</p>",
        "media_position": "left",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48,
        "background_color": "{{ settings.color_palette.color3 }}"
      }
    },
    "audience": {
      "type": "network-stats",
      "settings": {
        "eyebrow": "Daily Faceoff",
        "heading": "The numbers behind the brand",
        "subheading": "Page views, podcast streams and social following across dailyfaceoff.com and its shows.",
        "animate": true,
        "duration": 1800,
        "footnote": "",
        "section_width": "page-width",
        "background_color": "",
        "padding-block-start": 88,
        "padding-block-end": 56
      },
      "blocks": {
        "pageviews": {
          "type": "stat",

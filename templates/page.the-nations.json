{
  "sections": {
    "header": {
      "type": "section",
      "blocks": {
        "title": {
          "type": "text",
          "name": "Title",
          "settings": {
            "text": "<h1>The Nations</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "uppercase",
            "wrap": "balance"
          },
          "blocks": {}
        },
        "intro": {
          "type": "text",
          "name": "Intro",
          "settings": {
            "text": "<p>Our digital hubs are dedicated fan communities driven by a passion for their favourite teams, blending news, opinion, statistics and entertainment.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "title",
        "intro"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 16,
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 16
      }
    },
    "sites": {
      "type": "brand-mosaic",
      "settings": {
        "eyebrow": "",
        "heading": "",
        "subheading": "",
        "columns": 6,
        "columns_mobile": 3,
        "ratio": "4 / 3",
        "gap": 0,
        "open_in_new_tab": true,
        "button_label": "",
        "button_link": "",
        "section_width": "page-width",
        "background_color": "",
        "padding-block-start": 24,
        "padding-block-end": 40
      },
      "blocks": {
        "tile_oilersnation": {
          "type": "tile",
          "settings": {
            "name": "OilersNation",
            "tile_color": "#0d1230",
            "link": "https://oilersnation.com/"
          }
        },
        "tile_flamesnation": {
          "type": "tile",
          "settings": {
            "name": "FlamesNation",
            "tile_color": "#890403",
            "link": "https://flamesnation.ca/"
          }
        },
        "tile_canucksarmy": {
          "type": "tile",
          "settings": {
            "name": "CanucksArmy",
            "tile_color": "#044220",
            "link": "https://canucksarmy.com/"
          }
        },
        "tile_theleafsnation": {
          "type": "tile",
          "settings": {
            "name": "TheLeafsNation",
            "tile_color": "#00365e",
            "link": "https://theleafsnation.com/"
          }
        },
        "tile_bluejaysnation": {
          "type": "tile",
          "settings": {
            "name": "BlueJaysNation",
            "tile_color": "#ffffff",
            "link": "https://bluejaysnation.com/"
          }
        },
        "tile_raptors_republic": {
          "type": "tile",
          "settings": {
            "name": "Raptors Republic",
            "tile_color": "#ffffff",
            "link": "https://www.raptorsrepublic.com/"
          }
        }
      },
      "block_order": [
        "tile_oilersnation",
        "tile_flamesnation",
        "tile_canucksarmy",
        "tile_theleafsnation",
        "tile_bluejaysnation",
        "tile_raptors_republic"
      ]
    },
    "websites": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-site-oilersnation",
            "alt": "OilersNation open on a laptop"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-site-theleafsnation",
            "alt": "TheLeafsNation open on a phone"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "Editorial",
        "heading": "Fan first websites",
        "body": "<p>Our collection of NHL, MLB and NBA team-focused websites offers thought-provoking and insightful perspectives on the teams fans follow. Authored by knowledgeable writers and passionate fans, the sites carry in-depth analysis, opinion, player evaluations and game reviews, and give fans somewhere to argue about all of it.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "podcasts": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-barnburner",
            "alt": "Barn Burner recording with three hosts on camera"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-show-thesheet",
            "alt": "The Sheet recording with two hosts on camera"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "Listen",
        "heading": "Podcasts and shows",
        "body": "<p>Hosted by a knowledgeable team of sports enthusiasts, the Nation podcasts cover game previews and recaps, in-depth analysis, player interviews and insider discussion. Whether you want the latest news, expert opinion or an entertaining argument about the team you love, the shows have it.</p>",
        "media_position": "left",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56,
        "background_color": "{{ settings.color_palette.color3 }}"
      }
    },
    "social": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-social-oilersnation-x",
            "alt": "The OilersNation profile on X"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-social-oilersnation-facebook",
            "alt": "The OilersNation page on Facebook"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "Social",
        "heading": "Social media",
        "body": "<p>With a vibrant online presence, the Nation social accounts give fans timely updates, engaging content, humorous banter and interactive discussion. From breaking news and highlights to behind-the-scenes glimpses, the channels keep fans connected and informed.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "audience": {
      "type": "network-stats",
      "settings": {
        "eyebrow": "The Nations",
        "heading": "Five fan communities, one audience",
        "subheading": "Editorial, podcasts and social for the Oilers, Flames, Canucks, Leafs and Blue Jays.",
        "animate": true,
        "duration": 1800,
        "footnote": "",
        "section_width": "page-width",
        "background_color": "",
        "padding-block-start": 88,
        "padding-block-end": 56
      },
      "blocks": {
        "pageviews": {
          "type": "stat",
          "settings": {
            "value": "55.3",
            "suffix": "M+",
            "decimals": 1,
            "label": "Annual web page views"
          }
        },
        "streams": {
          "type": "stat",
          "settings": {
            "value": "7.89",
            "suffix": "M+",
            "decimals": 2,
            "label": "Annual show streams"
          }
        },
        "social": {
          "type": "stat",
          "settings": {
            "value": "681",
            "suffix": "K+",
            "decimals": 0,
            "label": "Social media followers"
          }
        }
      },
      "block_order": [
        "pageviews",
        "streams",
        "social"
      ]
    },
    "cta": {
      "type": "trust-points",
      "blocks": {
        "point_1": {
          "type": "point",
          "settings": {
            "icon": "silhouette",
            "text": "10+ fan-driven websites across North America"
          }
        },
        "point_2": {
          "type": "point",
          "settings": {
            "icon": "chat_bubble",
            "text": "28+ podcasts and shows, every week"
          }
        },
        "point_3": {
          "type": "point",
          "settings": {
            "icon": "star",
            "text": "Campaigns and content built with you, not templated"
          }
        },
        "point_4": {
          "type": "point",
          "settings": {
            "icon": "heart",
            "text": "Digital and live events, run end to end"
          }
        }
      },
      "block_order": [
        "point_1",
        "point_2",
        "point_3",
        "point_4"
      ],
      "settings": {
        "eyebrow": "Partner with us",
        "heading": "Reach these fans where they already are",
        "text": "<p>10+ fan-driven websites, 28+ unique podcasts, a powerful social presence, and standout digital and live events. We build campaigns around your objectives rather than selling a package.</p>",
        "button_label": "Start a conversation",
        "image_position": "right",
        "section_width": "page-width",
        "padding-block-start": 40,
        "padding-block-end": 40,
        "stock_image": "stadium_seats",
        "button_link": "/pages/partner-with-us"
      }
    }
  },
  "order": [
    "header",
    "sites",
    "websites",
    "podcasts",
    "social",
    "audience",
    "cta"
  ]
}

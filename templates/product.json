            "divider_bottom": {
              "type": "_divider",
              "name": "t:names.divider",
              "settings": {
                "thickness": 1,
                "corner_radius": "square",
                "divider_color": "{{ settings.color_palette.color2 }}",
                "width_percent": 100,
                "padding-block-start": 8,
                "padding-block-end": 0
              },
              "blocks": {}
            },
            "details": {
              "type": "trip-details",
              "settings": {
                "open_first": true,
                "show_overview": true,
                "overview_label": "Overview",
                "show_included": true,
                "included_label": "What's included",
                "show_itinerary": true,
                "itinerary_label": "Itinerary",
                "show_good_to_know": true,
                "good_to_know_label": "Good to know",

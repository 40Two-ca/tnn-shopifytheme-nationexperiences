            "badge": {
              "type": "trip-badge",
              "settings": {
                "label_override": "",
                "style": "accent",
                "placement": "inline"
              },
              "blocks": {}
            },
            "title": {
              "type": "text",
              "name": "t:names.product_title",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "font_size": "1rem",
                "line_height": "tight",
                "letter_spacing": "tight",
                "case": "none",
                "wrap": "balance",
                "text_color": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0

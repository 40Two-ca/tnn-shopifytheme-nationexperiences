            "meta": {
              "type": "trip-meta",
              "settings": {
                "show_duration": true,
                "show_location": true,
                "show_dates": true,
                "show_group": true,
                "size": "medium"
              },
              "blocks": {}
            },
            "excerpt": {
              "type": "product-excerpt",
              "settings": {
                "max_words": 30,
                "clamp": false,
                "lines": 3

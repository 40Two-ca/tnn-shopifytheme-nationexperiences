      "settings": {
        "eyebrow": "Follow",
        "heading": "Where to follow the shows",
        "subheading": "BlueJaysNation Radio is not listed: the show ended and its podcast feed now carries a different programme.",
        "columns": 3,
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 72
      }

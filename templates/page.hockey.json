    "dfo": {
      "type": "section",
      "blocks": {
        "title": {
          "type": "text",
          "name": "Title",
          "settings": {
            "text": "<h2 id=\"daily-faceoff\">Daily Faceoff</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "uppercase",
            "wrap": "balance"
          },
          "blocks": {}
        },
        "intro": {
          "type": "text",
          "name": "Intro",
          "settings": {
            "text": "<p>The ultimate destination for NHL enthusiasts: up-to-the-minute breaking news, expert insights and thought-provoking opinions.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)"
          },

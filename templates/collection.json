{
  "sections": {
    "header": {
      "type": "section",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>Experiences</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h6",
            "font": "var(--font-subheading--family)",
            "font_size": "0.75rem",
            "line_height": "normal",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "title": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ closest.collection.title }}</h1>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "font_size": "1rem",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "uppercase",
            "wrap": "balance",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "description": {
          "type": "text",
          "name": "t:names.description",
          "settings": {
            "text": "{{ closest.collection.description }}",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": ["eyebrow", "title", "description"],
      "name": "t:names.heading",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 8,
        "section_width": "page-width",
        "section_height_custom": 50,
        "background_media": "none",
        "background_color": "{{ settings.color_palette.background }}",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 48,
        "padding-block-end": 24
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "vertical",
            "filter_width": "centered",
            "text_label_case": "uppercase",
            "show_swatch_label": false,
            "show_filter_label": true,
            "enable_sorting": true,
            "enable_grid_density": false,
            "padding-block-start": 8,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 8,
            "facets_margin_right": 24
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 10,
            "background_color": "{{ settings.color_palette.background }}",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 8,
            "padding-block-start": 0,
            "padding-block-end": 16,
            "padding-inline-start": 16,
            "padding-inline-end": 16
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "landscape",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "badge": {
              "type": "trip-badge",
              "settings": {
                "label_override": "",
                "style": "accent",
                "placement": "on_image"
              },
              "blocks": {}
            },
            "title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-heading--family)",
                "font_size": "1rem",
                "line_height": "tight",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 6,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "meta": {
              "type": "trip-meta",
              "settings": {
                "show_duration": true,
                "show_location": true,
                "show_dates": true,
                "show_group": false,
                "size": "small"
              },
              "blocks": {}
            },
            "excerpt": {
              "type": "product-excerpt",
              "settings": {
                "max_words": 22,
                "clamp": true,
                "lines": 2
              },
              "blocks": {}
            },
            "footer": {
              "type": "_product-card-group",
              "name": "t:names.group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": false,
                "horizontal_alignment": "space-between",
                "vertical_alignment": "flex-end",
                "align_baseline": false,
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 12,
                "width": "fill",
                "custom_width": 100,
                "width_mobile": "fill",
                "custom_width_mobile": 100,
                "height": "fit",
                "custom_height": 100,
                "background_media": "none",
                "video_position": "cover",
                "background_image_position": "cover",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "price": {
                  "type": "trip-price",
                  "settings": {
                    "prefix": "From",
                    "suffix": "",
                    "show_compare": true,
                    "compare_label": "Was",
                    "zero_price_text": "See details",
                    "size": "medium",
                    "alignment": "left"
                  },
                  "blocks": {}
                },
                "button": {
                  "type": "product-link-button",
                  "settings": {
                    "label": "View trip",
                    "sold_out_label": "Sold out",
                    "style_class": "button",
                    "full_width": false
                  },
                  "blocks": {}
                }
              },
              "block_order": ["price", "button"]
            }
          },
          "block_order": ["gallery", "badge", "title", "meta", "excerpt", "footer"]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "large",
        "mobile_product_card_size": "large",
        "enable_infinite_scroll": true,
        "products_per_page": 24,
        "product_grid_width": "centered",
        "full_width_on_mobile": true,
        "columns_gap_horizontal": 24,
        "columns_gap_vertical": 32,
        "padding-inline-start": 0,
        "padding-inline-end": 0,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 64
      }
    }
  },
  "order": ["header", "main"]
}

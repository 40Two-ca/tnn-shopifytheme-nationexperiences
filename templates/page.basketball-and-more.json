    "slice_site": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "brand-the-slice",
            "alt": "The Slice Tennis logo"
          }
        }
      },
      "block_order": [
        "photo_1"
      ],
      "settings": {
        "eyebrow": "theslicetennis.com",
        "heading": "Canadian tennis, and the tours around it",
        "body": "<p>The Slice brings tennis fans closer to the action with exclusive interviews, original web shows, news and more. ATP and WTA writing sits beside a dedicated Canadian news desk, an opinion column, and racquet, shoe and string reviews for people who actually play.</p><p>Three shows run off it. <strong>The Slice Tennis Podcast</strong> is weekly, hosted by Stephen Boughton and J.P. Hovey, and looks at the game from a different perspective. <strong>North of the Net</strong> is Canadian tennis, with Crina Mustafa, Brendan McCarthy and Stephen Boughton. And the interviews are recorded on the road at ATP tournaments, with Milos Raonic, Dan Evans and Thanasi Kokkinakis among the players who have sat down with the show.</p><ul><li><a href=\"https://shows.acast.com/the-slice-tennis-podcast\" target=\"_blank\" rel=\"noopener noreferrer\">The Slice Tennis Podcast</a></li><li><a href=\"https://www.youtube.com/channel/UCiO_r211ysSeA1c4rQVznXA\" target=\"_blank\" rel=\"noopener noreferrer\">The Slice Tennis on YouTube</a></li></ul>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "contain",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56,
        "button_label": "Visit theslicetennis.com",
        "button_link": "https://www.theslicetennis.com/",
        "button_style": "button",
        "background_color": "{{ settings.color_palette.color3 }}"
      }

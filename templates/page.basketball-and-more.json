        "intro": {
          "type": "text",
          "name": "Intro",
          "settings": {
            "text": "<p>An independent Toronto Raptors publication: news, analysis, podcasts, editorials and video. It joined The Nation Network in October 2024 and kept its own name, its own editors and its own way of covering the team.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)"
          },

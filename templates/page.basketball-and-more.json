        "intro": {
          "type": "text",
          "name": "Intro",
          "settings": {
            "text": "<p>A podcast and a live show, hosted by Will Lou and Alex Wong with Jerome Cheng producing. Basketball generally and the Toronto Raptors particularly, for people who have followed the sport for years and people who picked it up last season.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",

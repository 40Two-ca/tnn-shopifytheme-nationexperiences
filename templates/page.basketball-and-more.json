            "bundled": "photo-events-4",
            "alt": "Hello and Welcome recorded in front of an audience"
          }
        }
      },
      "block_order": [
        "photo_1"
      ],
      "settings": {
        "eyebrow": "With Will Lou and Alex Wong",
        "heading": "A podcast and a live show",
        "body": "<p>Pre- and post-game analysis, watch-alongs, insider stories, game recaps and interviews with players and coaches. Video on YouTube, audio wherever you get podcasts, and a voicemail line on the show's own site for anyone with something to say back.</p><p>It does not all happen in a studio. Hello and Welcome is a live show as well as a podcast, recorded in front of an audience.</p>",
        "media_position": "right",
        "ratio": "4 / 3",
        "media_fit": "cover",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },

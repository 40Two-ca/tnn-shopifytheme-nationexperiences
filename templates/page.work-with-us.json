          "settings": {
            "text": "<h1>Work With Us</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "uppercase",
            "wrap": "balance"

        "title": {
          "type": "text",
          "name": "Title",
          "settings": {
            "text": "<h1>Partner With Us</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "uppercase",
            "wrap": "balance"
          },
          "blocks": {}
        },
        "intro": {
          "type": "text",
          "name": "Intro",
          "settings": {
            "text": "<p>Looking to connect your brand directly with sports fans? Let's talk.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "title",
        "intro"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 16,
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 16
      }
    },
    "pitch": {
      "type": "story-strand",
      "blocks": {
        "photo_1": {
          "type": "photo",
          "settings": {
            "bundled": "photo-events-1",
            "alt": "A host with a microphone in front of a watch-party crowd"
          }
        },
        "photo_2": {
          "type": "photo",
          "settings": {
            "bundled": "photo-events-3",
            "alt": "Fans in Oilers jerseys at a Nation Network event"
          }
        }
      },
      "block_order": [
        "photo_1",
        "photo_2"
      ],
      "settings": {
        "eyebrow": "Who we are",
        "heading": "Part of Better Collective",
        "body": "<p>At The Nation Network we connect brands with some of the most passionate sports fans across North America. With 10+ fan-driven websites, 28+ unique podcasts, a powerful social presence and standout digital and live events, we know how to create impact and drive real engagement. Whether you are looking to grow your brand, reach a targeted sports audience, host memorable events or co-create content that actually resonates, we are here to make it happen.</p>",
        "media_position": "right",
        "ratio": "1",
        "media_fit": "cover",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },

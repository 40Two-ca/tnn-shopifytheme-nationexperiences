{%- comment -%}
  Day-by-day trip timeline (Contiki's "Itinerary" rail).

  Days come from the product metafield custom.itinerary_days: one day per line,
  written as `Day label | Title | Description`. Title and description are optional:

    Friday, Nov 13 | Arrive in Toronto | Settle into your downtown hotel, then welcome drinks.
    Saturday, Nov 14 | Game day
    Sunday, Nov 15 | Nation watch party | An exclusive party at a local hot spot.

  When the metafield is empty the section falls back to its own blocks, so it can
  also be used on a page or as a designed example.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign raw_days = ''
  if product != blank
    assign raw_days = product.metafields.custom.itinerary_days
  endif

  assign day_lines = raw_days | strip | newline_to_br | split: '<br />'

  assign has_metafield_days = false
  if raw_days != blank
    assign has_metafield_days = true
  endif

  if s.background_color != blank
    render 'contrast-override', background_color: s.background_color, section_id: section.id
  endif
-%}

{%- if has_metafield_days or section.blocks.size > 0 -%}
  <div
    class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="section section--{{ s.section_width }} spacing-style trip-timeline{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="{% render 'spacing-style', settings: s %}"
  >
    <div class="trip-timeline__inner">
      {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
        <div class="brand-section-header brand-section-header--left trip-timeline__header">
          {%- if s.eyebrow != blank -%}
            <p class="brand-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="h3 trip-timeline__heading">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.subheading != blank -%}
            <p class="brand-subheading">{{ s.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ol class="trip-timeline__list list-unstyled">
        {%- if has_metafield_days -%}
          {%- for line in day_lines -%}
            {%- liquid
              assign row = line | strip_html | strip
              if row == blank
                continue
              endif
              assign parts = row | split: '|'
              assign day_label = parts[0] | strip
              assign day_title = parts[1] | strip
              assign day_text = parts[2] | strip
            -%}
            <li class="trip-timeline__day">
              <span class="trip-timeline__marker" aria-hidden="true"></span>
              <div class="trip-timeline__content">
                <p class="trip-timeline__label">{{ day_label }}</p>
                {%- if day_title != blank -%}
                  <p class="trip-timeline__title">{{ day_title }}</p>
                {%- endif -%}
                {%- if day_text != blank -%}
                  <p class="trip-timeline__text">{{ day_text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign d = block.settings -%}
            <li class="trip-timeline__day" {{ block.shopify_attributes }}>
              <span class="trip-timeline__marker" aria-hidden="true"></span>
              <div class="trip-timeline__content">
                {%- if d.day_label != blank -%}
                  <p class="trip-timeline__label">{{ d.day_label }}</p>
                {%- endif -%}
                {%- if d.title != blank -%}
                  <p class="trip-timeline__title">{{ d.title }}</p>
                {%- endif -%}
                {%- if d.text != blank -%}
                  <div class="trip-timeline__text rte">{{ d.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ol>

      {%- if s.button_label != blank and s.button_link != blank -%}
        <div class="trip-timeline__footer">
          <a class="button-secondary" href="{{ s.button_link }}">{{ s.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .trip-timeline__inner {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: calc(var(--brand-card-radius) * 2);
    background: var(--brand-surface);
  }

  .trip-timeline__header {
    margin-block-end: 1.5rem;
  }

  .trip-timeline__heading {
    margin: 0;
  }

  .trip-timeline__list {
    display: grid;
    margin: 0;
    padding: 0;
    counter-reset: trip-timeline;
  }

  .trip-timeline__day {
    position: relative;
    display: flex;
    gap: 1rem;
    padding-block: 0.9rem;
    padding-inline-start: 0;
  }

  /* The rail: a line from each marker down to the next one. */
  .trip-timeline__day::before {
    content: '';
    position: absolute;
    inset-block: 1.85rem -0.05rem;
    inset-inline-start: 0.5rem;
    width: 2px;
    background: rgb(var(--color-foreground-rgb) / 0.18);
  }

  .trip-timeline__day:last-child::before {
    display: none;
  }

  .trip-timeline__marker {
    position: relative;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-block-start: 0.2rem;
    border-radius: 50%;
    background: var(--brand-accent);
    box-shadow: 0 0 0 3px var(--brand-surface), 0 0 0 4px rgb(var(--color-foreground-rgb) / 0.18);
  }

  .trip-timeline__content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .trip-timeline__label {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .trip-timeline__title {
    max-width: 40ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.125rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .trip-timeline__text {
    /* Cap the measure: without this a one-line day runs the full width of the page. */
    max-width: 68ch;
    margin: 0.15rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.75);
    text-wrap: pretty;
  }

  .trip-timeline__footer {
    margin-block-start: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trip timeline",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the product metafield custom.itinerary_days: one day per line, written as \"Day label | Title | Description\". Add blocks below to design an example when the metafield is empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Itinerary"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The weekend at a glance"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "day",
      "name": "Day",
      "settings": [
        {
          "type": "text",
          "id": "day_label",
          "label": "Day label",
          "default": "Day 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Arrive"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Trip timeline",
      "category": "Nation Experiences"
    }
  ]
}
{% endschema %}

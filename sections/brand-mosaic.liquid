{%- comment -%}
  The edge-to-edge show/brand tile wall from thenationnetwork.com
  ("Sports content for everyone"). Each tile carries its own background colour
  so the grid reads as one mosaic rather than a row of cards.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  if s.background_color != blank
    render 'contrast-override', background_color: s.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ s.section_width }} spacing-style brand-mosaic{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: s %}
    --mosaic-columns: {{ s.columns }};
    --mosaic-columns-mobile: {{ s.columns_mobile }};
    --mosaic-ratio: {{ s.ratio }};
    --mosaic-gap: {{ s.gap }}px;
  "
>
  {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
    <div class="brand-section-header">
      {%- if s.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="brand-mosaic__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="brand-subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="brand-mosaic__grid list-unstyled">
    {%- for block in section.blocks -%}
      {%- assign tile = block.settings -%}
      {%- liquid
        assign tag = 'div'
        if tile.link != blank
          assign tag = 'a'
        endif
      -%}
      <li class="brand-mosaic__item" {{ block.shopify_attributes }}>
        <{{ tag }}
          class="brand-mosaic__tile"
          {% if tile.link != blank %}
            href="{{ tile.link }}"
            {% if s.open_in_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          {% endif %}
          {% if tile.tile_color != blank %}
            style="--mosaic-tile-color: {{ tile.tile_color }};"
          {% endif %}
        >
          {%- if tile.image != blank -%}
            {{
              tile.image
              | image_url: width: 800
              | image_tag: widths: '200, 300, 400, 600, 800', class: 'brand-mosaic__image', loading: 'lazy', alt: tile.name
            }}
          {%- else -%}
            <span class="brand-mosaic__fallback">{{ tile.name | default: 'Brand' }}</span>
          {%- endif -%}
          {%- if tile.name != blank and tile.link != blank -%}
            <span class="visually-hidden">{{ tile.name }}</span>
          {%- endif -%}
        </{{ tag }}>
      </li>
    {%- endfor -%}
  </ul>

  {%- if s.button_label != blank and s.button_link != blank -%}
    <div class="brand-mosaic__actions">
      <a class="button-secondary" href="{{ s.button_link }}">{{ s.button_label }}</a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .brand-mosaic__heading {
    margin: 0;
  }

  .brand-mosaic__grid {
    display: grid;
    grid-template-columns: repeat(var(--mosaic-columns, 6), minmax(0, 1fr));
    gap: var(--mosaic-gap, 0px);
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-radius: var(--brand-card-radius);
  }

  .brand-mosaic__item {
    display: flex;
  }

  .brand-mosaic__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: var(--mosaic-ratio, 1);
    padding: 8%;
    background: var(--mosaic-tile-color, var(--brand-surface));
    text-decoration: none;
    transition: transform var(--hover-transition-duration) var(--hover-transition-timing),
      filter var(--hover-transition-duration) var(--hover-transition-timing);
  }

  a.brand-mosaic__tile:hover {
    transform: scale(1.04);
    filter: brightness(1.08);
    position: relative;
    z-index: 1;
  }

  .brand-mosaic__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-mosaic__fallback {
    font-family: var(--font-subheading--family);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .brand-mosaic__actions {
    display: flex;
    justify-content: center;
    margin-block-start: 2.5rem;
  }

  @media screen and (max-width: 989px) {
    .brand-mosaic__grid {
      grid-template-columns: repeat(var(--mosaic-columns-mobile, 3), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand mosaic",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sports content for everyone" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile shape",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "Open links in a new tab", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name", "info": "Shown until a logo is uploaded. Used as alt text." },
        { "type": "color", "id": "tile_color", "label": "Tile background" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 48,
  "presets": [
    {
      "name": "Brand mosaic",
      "category": "The Nation Network",
      "blocks": [
        { "type": "tile", "settings": { "name": "Daily Faceoff" } },
        { "type": "tile", "settings": { "name": "Hockey Fights" } },
        { "type": "tile", "settings": { "name": "Oilers Nation" } },
        { "type": "tile", "settings": { "name": "Flames Nation" } },
        { "type": "tile", "settings": { "name": "Canucks Army" } },
        { "type": "tile", "settings": { "name": "The Leafs Nation" } },
        { "type": "tile", "settings": { "name": "Blue Jays Nation" } },
        { "type": "tile", "settings": { "name": "Raptors Republic" } }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  "Book with confidence" panel: heading, check-marked reassurance points, a button and a photo.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  if s.background_color != blank
    render 'contrast-override', background_color: s.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ s.section_width }} spacing-style trust-points{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- liquid
    assign has_media = false
    if s.image != blank
      assign has_media = true
    elsif s.stock_image != blank and s.stock_image != 'none'
      assign has_media = true
    endif
  -%}
  <div class="trust-points__inner trust-points__inner--image-{{ s.image_position }}{% unless has_media %} trust-points__inner--no-image{% endunless %}">
    <div class="trust-points__content">
      {%- if s.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="h2 trust-points__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="rte trust-points__text">{{ s.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="trust-points__list list-unstyled">
          {%- for block in section.blocks -%}
            <li class="trust-point" {{ block.shopify_attributes }}>
              <span class="trust-point__icon">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                  {%- render 'icon', icon: block.settings.icon -%}
                </svg>
              </span>
              <span class="trust-point__text">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a
          class="button trust-points__button"
          {% if s.button_link != blank %}
            href="{{ s.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{- s.button_label -}}
        </a>
      {%- endif -%}
    </div>

    {%- if s.image != blank -%}
      <div class="trust-points__media">
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '400, 600, 800, 1000, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'trust-points__image',
            loading: 'lazy'
        }}
      </div>
    {%- elsif has_media -%}
      <div class="trust-points__media">
        {% render 'stock-image', key: s.stock_image, class: 'trust-points__image' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .trust-points__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    overflow: hidden;
    border-radius: calc(var(--brand-card-radius) * 2);
    background: var(--brand-surface);
  }

  .trust-points__inner--image-left .trust-points__content {
    order: 2;
  }

  .trust-points__inner--no-image {
    grid-template-columns: 1fr;
  }

  .trust-points__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .trust-points__heading {
    margin: 0;
  }

  .trust-points__text {
    max-width: 36rem;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  .trust-points__list {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }

  .trust-point {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: 1rem;
  }

  .trust-point__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--brand-accent);
    color: var(--brand-accent-contrast);
  }

  .trust-point__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .trust-points__button {
    margin-block-start: 0.5rem;
  }

  .trust-points__media {
    align-self: stretch;
    min-height: 320px;
  }

  .trust-points__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .trust-points__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .trust-points__inner--image-left .trust-points__content {
      order: 0;
    }

    .trust-points__media {
      min-height: 220px;
      max-height: 320px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Book with confidence",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book with confidence"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Real people, real answers. Every experience is run by the Nation team, so if plans change you talk to us, not a call centre.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find out more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "stock_image",
      "label": "Stock photo (used until an image is picked)",
      "options": [
            { "value": "none", "label": "None" },
            { "value": "crowd", "label": "Fans cheering" },
            { "value": "arena", "label": "Hockey arena" },
            { "value": "fans", "label": "Friends celebrating" },
            { "value": "stadium_seats", "label": "Stadium seats" },
            { "value": "road_trip", "label": "Mountain road trip" },
            { "value": "jasper", "label": "Jasper" },
            { "value": "toronto", "label": "Toronto" },
            { "value": "edmonton", "label": "Edmonton" },
            { "value": "calgary", "label": "Calgary" },
            { "value": "airport", "label": "Airport" }
          ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check_box", "label": "Check" },
            { "value": "lock", "label": "Lock" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "heart", "label": "Heart" },
            { "value": "plane", "label": "Plane" },
            { "value": "star", "label": "Star" },
            { "value": "chat_bubble", "label": "Chat" },
            { "value": "question_mark", "label": "Question" },
            { "value": "silhouette", "label": "Person" }
          ],
          "default": "check_box"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Secure your spot with a deposit"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Book with confidence",
      "category": "Nation Experiences",
      "blocks": [
        { "type": "point", "settings": { "icon": "lock", "text": "Secure checkout, powered by Shopify" } },
        { "type": "point", "settings": { "icon": "check_box", "text": "Tickets, transport and stays in one booking" } },
        { "type": "point", "settings": { "icon": "chat_bubble", "text": "A Nation host on every trip" } },
        { "type": "point", "settings": { "icon": "heart", "text": "Fans travelling with fans" } }
      ]
    }
  ]
}
{% endschema %}

{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "announcement": {
      "type": "header-announcements",
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "The Nation travels together. New experiences now booking.",
            "link": "shopify://collections/all",
            "font": "var(--font-subheading--family)",
            "font_size": "0.75rem",
            "weight": "700",
            "letter_spacing": "loose",
            "case": "uppercase",
            "text_color": "{{ settings.color_palette.foreground }}"
          },
          "blocks": {}
        }
      },
      "block_order": ["announcement_1"],
      "name": "t:names.announcement_bar",
      "settings": {
        "speed": 5,
        "section_width": "full-width",
        "background_color": "{{ settings.color_palette.color1 }}",
        "divider_width": 0,
        "divider_color": "{{ settings.color_palette.color2 }}",
        "padding-block-start": 10,
        "padding-block-end": 10
      }
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "background_color": "{{ settings.color_palette.background }}",
            "type_font_primary_size": "0.8125rem",
            "menu_font_style": "regular",
            "type_font_primary_link": "subheading",
            "type_case_primary_link": "uppercase",
            "menu_style": "collection_images",
            "featured_products_aspect_ratio": "4 / 5",
            "featured_collections_aspect_ratio": "16 / 9",
            "image_border_radius": 8,
            "navigation_bar": false,
            "drawer_accordion": true,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": true
          },
          "blocks": {}
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "left",
        "menu_row": "top",
        "customer_account_menu": "customer-account-main-menu",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": false,
        "country_selector_style": false,
        "show_language": false,
        "localization_font": "subheading",
        "localization_font_size": "0.875rem",
        "localization_position": "right",
        "localization_row": "top",
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 1,
        "divider_size": "full-width",
        "divider_color": "{{ settings.color_palette.color2 }}",
        "border_width": 0,
        "actions_display_style": "text",
        "actions_font_size": "0.8125rem",
        "actions_font": "subheading",
        "actions_text_case": "uppercase",
        "background_color_top": "{{ settings.color_palette.background }}",
        "text_color_top": "{{ settings.color_palette.foreground }}",
        "enable_transparent_header_home": false,
        "enable_transparent_header_product": false,
        "enable_transparent_header_collection": false
      }
    }
  },
  "order": ["announcement", "header_section"]
}

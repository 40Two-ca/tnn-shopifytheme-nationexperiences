{%- comment -%}
  "Why us" photo tiles with bold overlay copy (Contiki's "Why Contiki?" row).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  if s.background_color != blank
    render 'contrast-override', background_color: s.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ s.section_width }} spacing-style feature-tiles{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: s %} --feature-tiles-columns: {{ s.columns }}; --feature-tiles-ratio: {{ s.ratio }};"
>
  {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
    <div class="brand-section-header">
      {%- if s.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="h2">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="brand-subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="feature-tiles__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile = block.settings
        assign tag = 'div'
        if tile.link != blank
          assign tag = 'a'
        endif
        assign placeholder_index = forloop.index0 | modulo: 3 | plus: 1
      -%}
      <{{ tag }}
        class="feature-tile"
        {% if tile.link != blank %}
          href="{{ tile.link }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if tile.image != blank -%}
          {{
            tile.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1400',
              sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
              class: 'feature-tile__image',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'hero-apparel-' | append: placeholder_index | placeholder_svg_tag: 'feature-tile__image feature-tile__image--placeholder' }}
        {%- endif -%}
        <div class="feature-tile__overlay"></div>
        <div class="feature-tile__content">
          {%- if tile.heading != blank -%}
            <h3 class="feature-tile__heading">{{ tile.heading }}</h3>
          {%- endif -%}
          {%- if tile.text != blank -%}
            <p class="feature-tile__text">{{ tile.text }}</p>
          {%- endif -%}
        </div>
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .feature-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--feature-tiles-columns, 3), minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (max-width: 989px) {
    .feature-tiles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .feature-tiles__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .feature-tile {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--feature-tiles-ratio, 4 / 3);
    border-radius: var(--brand-card-radius);
    background: var(--color-foreground);
    color: #fff;
    text-decoration: none;
    box-shadow: var(--brand-card-shadow);
  }

  .feature-tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .feature-tile__image--placeholder {
    background: #d9d9d9;
  }

  a.feature-tile:hover .feature-tile__image {
    transform: scale(1.04);
  }

  .feature-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78) 0%, rgb(0 0 0 / 0.25) 55%, rgb(0 0 0 / 0.05) 100%);
  }

  .feature-tile__content {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 1.5rem;
  }

  .feature-tile__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: balance;
  }

  .feature-tile__text {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.85);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature tiles",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why the Nation?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fan travel, done properly"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tickets, transport, stays and the people who make it a trip."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Every detail handled"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Feature tiles",
      "category": "Nation Experiences",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Game days, road trips and once-in-a-lifetime events" } },
        { "type": "tile", "settings": { "heading": "Tickets, transport and stays bundled into one booking" } },
        { "type": "tile", "settings": { "heading": "Travel with a Nation host and fans who get it" } }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Audience counters ported from thenationnetwork.com ("Our audience").
  Numbers count up once the section scrolls into view; the offset plate behind
  each card is the same trick the marketing site uses.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  if s.background_color != blank
    render 'contrast-override', background_color: s.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ s.section_width }} spacing-style network-stats{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: s %} --network-stats-columns: {{ section.blocks.size | at_most: 4 }};"
>
  {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
    <div class="brand-section-header">
      {%- if s.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="network-stats__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="brand-subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="network-stats__list list-unstyled">
    {%- for block in section.blocks -%}
      {%- assign stat = block.settings -%}
      <li class="network-stats__item" {{ block.shopify_attributes }}>
        <div class="network-stats__card">
          <p class="network-stats__value">
            <span
              class="network-stats__number"
              data-network-stat
              data-value="{{ stat.value }}"
              data-decimals="{{ stat.decimals }}"
              data-duration="{{ s.duration }}"
            >{% if s.animate %}0{% else %}{{ stat.value }}{% endif %}</span>{{ stat.suffix }}
          </p>
          {%- if stat.label != blank -%}
            <p class="network-stats__label">{{ stat.label }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if s.footnote != blank -%}
    <p class="network-stats__footnote">{{ s.footnote }}</p>
  {%- endif -%}
</div>

{%- if s.animate -%}
  <script>
    (() => {
      const root = document.currentScript.previousElementSibling;
      if (!root) return;
      const numbers = root.querySelectorAll('[data-network-stat]');
      if (!numbers.length) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const format = (value, decimals) =>
        value.toLocaleString(undefined, {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        });

      const run = (el) => {
        const target = parseFloat(el.dataset.value) || 0;
        const decimals = parseInt(el.dataset.decimals, 10) || 0;
        const duration = parseInt(el.dataset.duration, 10) || 1800;

        if (reduced || duration === 0) {
          el.textContent = format(target, decimals);
          return;
        }

        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          // ease-out cubic, so it decelerates into the final number
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = format(target * eased, decimals);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            run(entry.target);
          });
        },
        { threshold: 0.4 }
      );

      numbers.forEach((el) => observer.observe(el));
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .network-stats__heading {
    margin: 0;
  }

  .network-stats__list {
    display: grid;
    grid-template-columns: repeat(var(--network-stats-columns, 3), minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin: 0;
    padding: 0;
  }

  .network-stats__item {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* The offset plate sitting behind and above-left of each card */
  .network-stats__item::before {
    content: '';
    position: absolute;
    inset: -1.25rem 1.25rem 1.25rem -1.25rem;
    background: var(--brand-surface);
    border-radius: var(--brand-card-radius);
  }

  .network-stats__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    min-height: 9.5rem;
    padding: 1.75rem 1.25rem;
    border-radius: var(--brand-card-radius);
    background: var(--color-foreground);
    color: var(--color-background);
    text-align: center;
  }

  .network-stats__value {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .network-stats__label {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: 700;
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .network-stats__footnote {
    margin: 2.5rem 0 0;
    text-align: center;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  @media screen and (max-width: 749px) {
    .network-stats__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Audience stats",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our audience" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "animate", "label": "Count up when scrolled into view", "default": true },
    {
      "type": "range",
      "id": "duration",
      "label": "Count-up duration",
      "min": 0,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "default": 1800
    },
    { "type": "text", "id": "footnote", "label": "Footnote" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Numbers only, e.g. 166 or 1.62.",
          "default": "100"
        },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "M+" },
        {
          "type": "range",
          "id": "decimals",
          "label": "Decimal places",
          "min": 0,
          "max": 2,
          "step": 1,
          "default": 0
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Annual web page views" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Audience stats",
      "category": "The Nation Network",
      "blocks": [
        { "type": "stat", "settings": { "value": "166", "suffix": "M+", "label": "Annual web page views" } },
        { "type": "stat", "settings": { "value": "57", "suffix": "M+", "label": "Annual show streams" } },
        {
          "type": "stat",
          "settings": { "value": "1.62", "suffix": "M+", "decimals": 2, "label": "Social media followers" }
        }
      ]
    }
  ]
}
{% endschema %}
